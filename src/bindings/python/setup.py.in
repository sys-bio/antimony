#!/usr/bin/env python

from setuptools import setup, Distribution

try:
    from setuptools.command.bdist_wheel import bdist_wheel
except ImportError:
    from wheel.bdist_wheel import bdist_wheel

class PureTagBdistWheel(bdist_wheel):
    """Tags the wheel py3-none-<platform>, since it does not depend on the Python version"""
    def get_tag(self):
        _, _, plat = super().get_tag()
        return ("py3", "none", plat)

class BinaryDistribution(Distribution):
    """Distribution which always forces a binary package with platform name"""
    def has_ext_modules(foo):
        return True


setup(name='antimony',
      version='${LIBANTIMONY_VERSION_STRING_NO_V}',
      description='Python bindings for libAntimony',
      author='Lucian Smith',
      author_email='lpsmith@uw.edu',
      url='http://antimony.sf.net/',
      packages=['antimony'],
      package_data={'antimony': ['*.py', '*.dll', '*.dylib', '*.so', '*.so.*' '*.txt']},
      license = "MIT",
      long_description=open('antimony/README.md', "r").read(),
      long_description_content_type='text/markdown',
#      install_requires=['ctypes'], #ctypes is built in.
      distclass=BinaryDistribution,
      cmdclass={'bdist_wheel': PureTagBdistWheel},
     )

